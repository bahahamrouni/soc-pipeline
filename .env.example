# Copy to .env and set your own values. Never commit .env.
# Generate strong passwords, for example:  openssl rand -base64 24
COMPOSE_PROJECT_NAME=soc-pipeline

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=socdb
POSTGRES_USER=socadmin
POSTGRES_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

KAFKA_BROKER=kafka:9092
KAFKA_TOPIC_RAW=wazuh-alerts-raw
KAFKA_TOPIC_PARSED=alerts-parsed
KAFKA_TOPIC_NORMALIZED=alerts-normalized
KAFKA_TOPIC_ENRICHED=alerts-enriched
KAFKA_TOPIC_INCIDENTS=incidents

WAZUH_ALERTS_PATH=/var/ossec/logs/alerts/alerts.json

# Published ports (Kafka, OpenSearch, dashboard) bind to localhost by default.
# Set to 0.0.0.0 only on an isolated lab network: the dashboard API has no authentication.
BIND_ADDR=127.0.0.1
LOG_LEVEL=INFO
